{
  "name": "traflix-space",
  "private": true,
  "version": "1.8.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:jarvis": "node --import tsx --test scripts/jarvis-state.test.mjs scripts/jarvis-manual-voice.test.mjs scripts/jarvis-wake-word.test.mjs scripts/ui-regression.test.mjs scripts/jarvis-voice-meter.test.mjs scripts/jarvis-voice-perf-regression.test.mjs scripts/jarvis-voice-endpointing.test.mjs scripts/jarvis-codex-stream.test.mjs scripts/e2e-static-regression.test.mjs scripts/codex-bootstrap.test.mjs",
    "test:terminal": "node --import tsx --test scripts/terminal-regression.test.mjs",
    "test:strict": "node scripts/run-strict-tests.mjs",
    "test:agent-notifications": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\agent-notifications\\test-adapters.ps1",
    "tauri": "tauri",
    "build:clean": "tauri build && cargo sweep --stale",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "version:set": "node scripts/bump-version.js set"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tauri-pty": "^0.3.0",
    "use-sync-external-store": "^1.6.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "^1.2.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
