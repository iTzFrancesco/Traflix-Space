{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Traflix Space",
  "version": "1.7.2",
  "identifier": "com.traflix.space",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Traflix Space",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": true
      },
      {
        "label": "agent-notification",
        "title": "Traflix Space",
        "width": 480,
        "height": 126,
        "minWidth": 480,
        "minHeight": 126,
        "maxWidth": 480,
        "maxHeight": 126,
        "center": false,
        "visible": false,
        "focus": false,
        "focusable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "url": "index.html?agent-notification"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc://localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; worker-src 'self' blob:; frame-src 'self' http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.ico"
    ],
    "resources": {
      "../scripts/agent-notifications/*": "agent-notifications/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
